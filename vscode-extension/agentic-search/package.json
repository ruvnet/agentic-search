{
  "name": "agentic-search",
  "displayName": "Agentic Search Copilot",
  "description": "Search powered AI assistant for VS Code, integrated with Copilot Chat",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "AI",
    "Machine Learning"
  ],
  "activationEvents": [
    "onCommand:agenticCopilot.start"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agenticCopilot.start",
        "title": "Start Agentic Copilot",
        "category": "Agentic Copilot"
      },
      {
        "command": "agenticCopilot.openSettings",
        "title": "Open Agentic Copilot Settings",
        "category": "Agentic Copilot"
      }
    ],
    "configuration": {
      "title": "Agentic Copilot",
      "properties": {
        "agenticCopilot.enableLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable detailed logging for debugging purposes"
        },
        "agenticCopilot.defaultSearchProvider": {
          "type": "string",
          "enum": [
            "keyword",
            "github",
            "openai",
            "exa"
          ],
          "default": "keyword",
          "description": "Default search provider to use when no specific command is given"
        },
        "agenticCopilot.openai.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for OpenAI services. This key will be moved to secure storage after initial configuration.",
          "scope": "application"
        },
        "agenticCopilot.exa.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for Exa AI services. This key will be moved to secure storage after initial configuration.",
          "scope": "application"
        },
        "agenticCopilot.jina.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for Jina AI services. This key will be moved to secure storage after initial configuration.",
          "scope": "application"
        }
      }
    },
    "copilotPlugins": [
      {
        "id": "agentic-copilot",
        "displayName": "Agentic Search",
        "description": "Powerful semantic, keyword, and contextual search through Copilot Chat",
        "url": "http://localhost:3000/",
        "scopes": ["chat"],
        "auth": {
          "type": "gitHubToken"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:jest": "jest --config=jest.config.js --runInBand"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
